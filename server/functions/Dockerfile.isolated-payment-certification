FROM eclipse-temurin:21-jre AS java
FROM node:22-bookworm-slim
COPY --from=java /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="/opt/java/openjdk/bin:${PATH}"
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://storage.googleapis.com/firebase-preview-drop/emulator/cloud-firestore-emulator-v1.21.0.jar -o /opt/firestore.jar && echo "c3d3680a89d946a90a027365ea14c26c6472a162bcf37f099bbb1ebd66d25e8e  /opt/firestore.jar" | sha256sum -c -
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY . ./
ARG CIRCUM_SOURCE_SHA=unknown
ENV CIRCUM_SOURCE_SHA=$CIRCUM_SOURCE_SHA
CMD ["node", "isolated-payment-certification-server.js"]
