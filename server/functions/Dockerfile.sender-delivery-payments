FROM node:22-bookworm-slim

ARG CIRCUM_SOURCE_SHA=unknown
ENV CIRCUM_SOURCE_SHA=$CIRCUM_SOURCE_SHA
ENV NODE_ENV=production
WORKDIR /srv/app

COPY server/functions/package.json server/functions/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY server/functions/ ./

EXPOSE 8080
CMD ["node", "cloud-run-sender-delivery-payments.js"]
