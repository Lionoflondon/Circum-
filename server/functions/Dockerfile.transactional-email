FROM node:22-bookworm-slim

ARG CIRCUM_SOURCE_SHA=unknown

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY . ./

ENV NODE_ENV=production
ENV CIRCUM_SOURCE_SHA=$CIRCUM_SOURCE_SHA
ENV HANDLER_KIND=transactional_email

USER node
CMD ["node", "cloud-run-transactional-email.js"]
