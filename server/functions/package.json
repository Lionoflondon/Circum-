{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint .",
    "test": "node --test $(find . -maxdepth 1 -name '*.test.js' ! -name 'firestore-*-rules.test.js' ! -name 'username-concurrency.test.js' -print)",
    "test:rules": "cd ../.. && firebase emulators:exec --only firestore \"node --test server/functions/firestore-live-tracking-rules.test.js server/functions/firestore-financial-authority-rules.test.js server/functions/firestore-sender-trust-rules.test.js\"",
    "test:iris": "node --test iris-core.test.js iris-security.test.js",
    "test:adjustments": "node --test delivery-adjustment-core.test.js",
    "check:functions-inventory": "node check-functions-inventory.js",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.6.0",
    "stripe": "^14.25.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0",
    "firebase": "^12.16.0",
    "firebase-functions-test": "^3.5.0"
  },
  "private": true
}
