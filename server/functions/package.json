{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint .",
    "test": "node --test $(find . -maxdepth 1 -name '*.test.js' ! -name 'firestore-*-rules.test.js' ! -name 'storage-*-rules.test.js' ! -name '*.emulator.test.js' ! -name 'rider-document-emulator-integration.test.js' -print)",
    "test:rules": "cd ../.. && firebase emulators:exec --only firestore \"node --test --test-concurrency=1 server/functions/firestore-*-rules.test.js server/functions/delivery-cancellation.emulator.test.js server/functions/rider-cancellation.emulator.test.js server/functions/weight-authority.emulator.test.js server/functions/tips-authority.emulator.test.js server/functions/rider-payout-allocation.emulator.test.js server/functions/newcomer-roth-cap.emulator.test.js server/functions/qa-lifecycle.emulator.test.js server/functions/arrival-authority.emulator.test.js\"",
    "test:storage-rules": "cd ../.. && firebase emulators:exec --only firestore,storage \"node --test server/functions/storage-rider-document-rules.test.js server/functions/storage-delivery-evidence-rules.test.js\"",
    "test:document-integration": "cd ../.. && firebase emulators:exec --only firestore,storage \"node --test server/functions/rider-document-emulator-integration.test.js\"",
    "test:lifecycle": "cd ../.. && firebase emulators:exec --only firestore,storage \"node --test server/functions/delivery-lifecycle.emulator.test.js\"",
    "test:iris": "node --test iris-core.test.js iris-security.test.js",
    "test:adjustments": "node --test delivery-adjustment-core.test.js",
    "check:functions-inventory": "node check-functions-inventory.js",
    "test:functions-inventory": "node --test check-functions-inventory.test.js",
    "generate:gen1-registry": "node gen1-architecture-registry.js",
    "check:gen1-architecture": "node gen1-architecture-registry.js --check",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:integration": "cd ../.. && firebase emulators:exec --only auth,firestore,storage \"node --test --test-concurrency=1 server/functions/*.emulator.test.js server/functions/rider-document-emulator-integration.test.js\""
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@google-cloud/tasks": "^6.3.0",
    "firebase-admin": "14.4.0",
    "firebase-functions": "7.4.0",
    "protobufjs": "^8.8.0",
    "stripe": "^14.25.0",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0",
    "firebase": "^12.16.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "private": true
}
