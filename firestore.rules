rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn() && (
        request.auth.token.adminRole == role ||
        request.auth.token.role == role ||
        (request.auth.token.roles is list && role in request.auth.token.roles)
      );
    }

    function isAdmin() {
      return hasRole('super_admin') ||
        hasRole('operations_admin') ||
        hasRole('support_agent') ||
        hasRole('finance_admin') ||
        hasRole('driver_manager');
    }

    function isFinanceAdmin() {
      return hasRole('super_admin') || hasRole('finance_admin');
    }

    function normalizedAuthEmail() {
      return signedIn() && request.auth.token.email is string ?
        request.auth.token.email.lower() :
        '';
    }

    function isDriverManager() {
      return hasRole('super_admin') || hasRole('driver_manager');
    }

    function payoutRawBankFieldsAbsent(data) {
      return !data.keys().hasAny([
        'bankName',
        'sortCode',
        'accountNumber',
        'bankAccountNumber'
      ]);
    }

    function riderPayoutProtectedFieldsAbsent(data) {
      return !data.keys().hasAny([
        'stripeConnectAccountId',
        'stripeAccountId',
        'stripeMode',
        'staleStripeAccountId',
        'staleStripeMode',
        'staleStripeResetAt',
        'stripeConnectType',
        'stripeStatus',
        'stripeConnectStatus',
        'stripeOnboardingStarted',
        'stripeOnboardingCreatedAt',
        'stripeDetailsSubmitted',
        'stripeChargesEnabled',
        'stripePayoutsEnabled',
        'stripeOnboardingStatus',
        'stripeLastSyncedAt',
        'stripeLastCheckedAt',
        'payoutsEnabled',
        'chargesEnabled',
        'onboardingComplete',
        'payoutPaused',
        'payoutFeePayer',
        'lastStripeSyncAt',
        'stripeRequirementsDue',
        'stripeRequirementsPastDue',
        'stripeDisabledReason'
      ]);
    }

    function riderPayoutProtectedFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'stripeConnectAccountId',
        'stripeAccountId',
        'stripeMode',
        'staleStripeAccountId',
        'staleStripeMode',
        'staleStripeResetAt',
        'stripeConnectType',
        'stripeStatus',
        'stripeConnectStatus',
        'stripeOnboardingStarted',
        'stripeOnboardingCreatedAt',
        'stripeDetailsSubmitted',
        'stripeChargesEnabled',
        'stripePayoutsEnabled',
        'stripeOnboardingStatus',
        'stripeLastSyncedAt',
        'stripeLastCheckedAt',
        'payoutsEnabled',
        'chargesEnabled',
        'onboardingComplete',
        'payoutPaused',
        'payoutFeePayer',
        'lastStripeSyncAt',
        'stripeRequirementsDue',
        'stripeRequirementsPastDue',
        'stripeDisabledReason'
      ]);
    }

    function ownsSenderRecord(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function changesLegendFields() {
      return request.resource.data.diff(resource.data).changedKeys().hasAny([
        'isLegend',
        'legendNumber',
        'legendAwardedAt',
        'legendSource',
        'legendDeliveryId'
      ]);
    }

    function changesSenderTrustFields() {
      return request.resource.data.diff(resource.data).changedKeys().hasAny([
        'senderTrustPoints',
        'trustPoints',
        'senderTier',
        'trustTier',
        'senderTrustFrozen',
        'senderTrustUpdatedAt',
        'senderTrustUpdatedBy',
        'senderTrustLastReason',
        'senderTrustBreakdown'
      ]);
    }

    function isRiderAccount() {
      return signedIn() && (
        hasRole('super_admin') ||
        exists(/databases/$(database)/documents/riderProfiles/$(request.auth.uid))
      );
    }

    function isOwnDelivery(deliveryId) {
      return signedIn() && (
        deliveryId == request.auth.uid ||
        resource.data.senderId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
    }

    function isAssignedRider() {
      return signedIn() && (
        resource.data.riderId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        resource.data.assignedDriverId == request.auth.uid
      );
    }

    function isAvailableRiderJob() {
      return isRiderAccount() && (
        resource.data.status == 'requested' ||
        resource.data.dispatchStatus == 'requested' ||
        resource.data.matchingStatus == 'available'
      );
    }

    function isCreatingOwnDelivery() {
      return signedIn() && (
        request.resource.data.senderId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
    }

    function isOwnDeliveryUpdate() {
      return isOwnDelivery('') &&
        !request.resource.data.diff(resource.data).changedKeys().hasAny(['iris']);
    }

    function isAssignedRiderUpdate() {
      return isAssignedRider() &&
        !request.resource.data.diff(resource.data).changedKeys().hasAny(['iris']);
    }

    function deliveryFor(deliveryId) {
      return get(/databases/$(database)/documents/deliveryRequests/$(deliveryId)).data;
    }

    function canReadDeliveryTracking(deliveryId) {
      return signedIn() && (
        isAdmin() ||
        deliveryFor(deliveryId).senderId == request.auth.uid ||
        deliveryFor(deliveryId).userId == request.auth.uid ||
        deliveryFor(deliveryId).riderId == request.auth.uid ||
        deliveryFor(deliveryId).driverId == request.auth.uid ||
        deliveryFor(deliveryId).assignedDriverId == request.auth.uid
      );
    }

    function canWriteOwnLiveLocation(deliveryId) {
      return signedIn() &&
        request.resource.data.riderId == request.auth.uid &&
        (
          deliveryFor(deliveryId).riderId == request.auth.uid ||
          deliveryFor(deliveryId).driverId == request.auth.uid ||
          deliveryFor(deliveryId).assignedDriverId == request.auth.uid
        ) &&
        request.resource.data.keys().hasOnly([
          'riderId',
          'latitude',
          'longitude',
          'heading',
          'speed',
          'accuracy',
          'updatedAt',
          'status'
        ]);
    }

    function isAssignedRiderPrivateCreate() {
      return signedIn() &&
        request.resource.data.deliveryDocId is string &&
        (
          get(/databases/$(database)/documents/deliveryRequests/$(request.resource.data.deliveryDocId)).data.riderId == request.auth.uid ||
          get(/databases/$(database)/documents/deliveryRequests/$(request.resource.data.deliveryDocId)).data.driverId == request.auth.uid ||
          get(/databases/$(database)/documents/deliveryRequests/$(request.resource.data.deliveryDocId)).data.assignedDriverId == request.auth.uid
        ) &&
        request.resource.data.keys().hasOnly(['requestId', 'deliveryDocId', 'verification', 'updatedAt']) &&
        request.resource.data.verification is map &&
        request.resource.data.verification.keys().hasOnly(['rider']);
    }

    function isSenderPrivateCreate() {
      return signedIn() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'version',
          'requestId',
          'senderId',
          'internal',
          'verification',
          'updatedAt',
          'createdAt'
        ]) &&
        request.resource.data.verification is map &&
        request.resource.data.verification.keys().hasOnly(['rider', 'adjudication']) &&
        request.resource.data.verification.rider == null &&
        request.resource.data.verification.adjudication == null;
    }

    function isAssignedRiderPrivateUpdate() {
      return signedIn() &&
        resource.data.deliveryDocId is string &&
        (
          get(/databases/$(database)/documents/deliveryRequests/$(resource.data.deliveryDocId)).data.riderId == request.auth.uid ||
          get(/databases/$(database)/documents/deliveryRequests/$(resource.data.deliveryDocId)).data.driverId == request.auth.uid ||
          get(/databases/$(database)/documents/deliveryRequests/$(resource.data.deliveryDocId)).data.assignedDriverId == request.auth.uid
        ) &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['verification', 'updatedAt']) &&
        request.resource.data.verification is map &&
        request.resource.data.verification.keys().hasOnly(['rider']);
    }

    function isParticipant() {
      return signedIn() &&
        resource.data.participants is list &&
        request.auth.uid in resource.data.participants;
    }

    function isCreatingAsParticipant() {
      return signedIn() &&
        request.resource.data.participants is list &&
        request.auth.uid in request.resource.data.participants;
    }

    match /adminUsers/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if hasRole('super_admin');
    }

    match /adminAuditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /adminNotes/{noteId} {
      allow read, create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if hasRole('super_admin');
    }

    match /supportTickets/{ticketId} {
      allow read, write: if isAdmin();
      allow create: if request.resource.data.channel == 'web_live_chat' &&
        request.resource.data.keys().hasOnly([
          'channel',
          'status',
          'priority',
          'name',
          'email',
          'message',
          'lastMessage',
          'lastMessageAt',
          'adminUnreadCount',
          'pageUrl',
          'chatId',
          'userId',
          'createdAt',
          'updatedAt'
        ]) &&
        (!request.resource.data.keys().hasAny(['chatId']) ||
          request.resource.data.chatId is string) &&
        (!request.resource.data.keys().hasAny(['userId']) ||
          (signedIn() && request.resource.data.userId == request.auth.uid));
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.recipientId == request.auth.uid);
      // Client-generated in-app notices remain restricted to the signed-in
      // recipient. Canonical status notices are written by Cloud Functions.
      allow create: if isAdmin() ||
        (signedIn() && request.resource.data.recipientId == request.auth.uid);
      allow update: if isAdmin() ||
        (signedIn() && resource.data.recipientId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'read', 'readAt', 'archived', 'archivedAt', 'deletedAt'
          ]));
      allow delete: if false;
    }

    match /giftsWaitlist/{entryId} {
      allow create: if request.resource.data.source == 'gifts-coming-soon' &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 3 &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.keys().hasOnly([
          'name',
          'email',
          'source',
          'createdAt'
        ]);
      allow read, update, delete: if isAdmin();
    }

    match /giftRequests/{giftRequestId} {
      allow create: if isAdmin();
      allow read: if isAdmin() ||
        (signedIn() && resource.data.senderId == request.auth.uid) ||
        (signedIn() &&
          resource.data.recipientEmail is string &&
          resource.data.recipientEmail.lower() == normalizedAuthEmail() &&
          resource.data.giftStoryEnabled != false &&
          resource.data.giftStoryApproved != false &&
          (resource.data.status in ['delivered', 'completed'] ||
            resource.data.giftStatus in ['delivered', 'completed']));
      allow update: if isAdmin() ||
        (signedIn() &&
          resource.data.recipientEmail is string &&
          resource.data.recipientEmail.lower() == normalizedAuthEmail() &&
          request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(['giftStoryRevealViewedAt', 'giftStoryUpdatedAt']));
      allow delete: if hasRole('super_admin');
    }

    match /giftPaymentDrafts/{giftDraftId} {
      allow create: if signedIn() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.status == 'draft' &&
        request.resource.data.paymentStatus == 'payment_pending' &&
        request.resource.data.grossBudget is number &&
        request.resource.data.grossBudget >= 50;
      allow read: if isAdmin() ||
        (signedIn() && resource.data.senderId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /giftBrands/{brandId} {
      allow read, create, update: if isAdmin();
      allow delete: if hasRole('super_admin');
    }

    match /giftCampaignParticipants/{participantId} {
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid &&
          !request.resource.data.diff(resource.data).changedKeys().hasAny([
            'matchedParticipantId',
            'matchScore',
            'matchReason',
            'matchStatus',
            'matchLockedAt',
            'matchApprovedBy'
          ]));
      allow delete: if hasRole('super_admin');
    }

    match /giftCampaignMatches/{matchId} {
      allow read, create, update: if isAdmin();
      allow delete: if hasRole('super_admin');
    }

    match /businessAccounts/{businessId} {
      allow read: if isAdmin() ||
        (signedIn() && (
          resource.data.createdByUserId == request.auth.uid ||
          request.auth.uid in resource.data.teamMemberIds ||
          normalizedAuthEmail() in resource.data.teamMemberIds
        ));
      allow create: if signedIn() &&
        request.resource.data.createdByUserId == request.auth.uid &&
        request.auth.uid in request.resource.data.teamMemberIds &&
        request.auth.uid in request.resource.data.managerIds;
      allow update: if isAdmin() ||
        (signedIn() && (
          resource.data.createdByUserId == request.auth.uid ||
          request.auth.uid in resource.data.managerIds ||
          normalizedAuthEmail() in resource.data.managerIds
        ) &&
        !request.resource.data.diff(resource.data).changedKeys().hasAny([
          'status',
          'notes',
          'monthlySpendLimit'
        ]));
      allow delete: if hasRole('super_admin');
    }

    match /irisLearningOutliers/{outlierId} {
      allow create: if signedIn() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.status == 'pending_review';
      allow read, update, delete: if isAdmin();
    }

    match /iris_learning/{itemKey}/records/{recordId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['weightKg', 'source', 'timestamp'])
        && request.resource.data.weightKg is number
        && request.resource.data.weightKg > 0
        && request.resource.data.weightKg < 2000;
      allow update, delete: if false;
    }

    match /deliveryAdjustments/{adjustmentId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.senderId == request.auth.uid) ||
        (signedIn() && resource.data.riderId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isFinanceAdmin();
      allow write: if isFinanceAdmin();
    }

    match /wallets/{userId} {
      allow read: if isFinanceAdmin() ||
        (signedIn() && (
          userId == request.auth.uid ||
          userId == normalizedAuthEmail() ||
          resource.data.uid == request.auth.uid ||
          resource.data.userEmail == normalizedAuthEmail()
        ));
      allow create, update, delete: if false;
    }

    match /senderWallets/{userId} {
      allow read: if isFinanceAdmin() ||
        (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if false;
    }

    match /walletTransactions/{transactionId} {
      allow read: if isFinanceAdmin() ||
        (signedIn() && (
          resource.data.userId == request.auth.uid ||
          resource.data.userId == normalizedAuthEmail() ||
          resource.data.uid == request.auth.uid ||
          resource.data.userEmail == normalizedAuthEmail()
        ));
      allow create, update, delete: if false;
    }

    match /users/{userId}/wallets/{walletType} {
      allow read: if isFinanceAdmin() ||
        (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if false;
    }

    match /rothLedger/{ledgerEntryId} {
      allow read: if isFinanceAdmin() ||
        (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /rothAdminIssues/{issueId} {
      allow read: if isFinanceAdmin();
      allow create, update, delete: if false;
    }

    match /giftCards/{code} {
      allow read: if isFinanceAdmin() ||
        (signedIn() && resource.data.redeemedBy == request.auth.uid);
      allow create, update: if isFinanceAdmin();
      allow delete: if hasRole('super_admin');
    }

    match /rothLedgerRepairLogs/{logId} {
      allow read, write: if isFinanceAdmin();
      allow delete: if hasRole('super_admin');
    }

    match /healthPlusPayments/{paymentId} {
      allow read: if isFinanceAdmin() ||
        hasRole('operations_admin') ||
        (signedIn() && resource.data.senderId == request.auth.uid) ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if isFinanceAdmin();
    }

    match /riderProfiles/{driverId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == driverId);
      allow create: if isDriverManager() ||
        (signedIn() && request.auth.uid == driverId &&
          riderPayoutProtectedFieldsAbsent(request.resource.data) &&
          (!('rank' in request.resource.data) || request.resource.data.rank == 'agent') &&
          (!('riderRank' in request.resource.data) || request.resource.data.riderRank == 'agent'));
      allow update: if isDriverManager() ||
        (signedIn() && request.auth.uid == driverId &&
          riderPayoutProtectedFieldsUnchanged() &&
          !request.resource.data.diff(resource.data).changedKeys().hasAny([
            'rank',
            'riderRank',
            'rankUpdatedAt',
            'rankUpdatedBy',
            'rankReason'
          ]));
      allow delete: if hasRole('super_admin');
    }

    match /riders/{driverId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == driverId);
      allow create, update: if isDriverManager() ||
        (signedIn() && request.auth.uid == driverId &&
          (
            (
              !exists(/databases/$(database)/documents/riders/$(driverId)) &&
              riderPayoutProtectedFieldsAbsent(request.resource.data)
            ) ||
            (
              exists(/databases/$(database)/documents/riders/$(driverId)) &&
              riderPayoutProtectedFieldsUnchanged()
            )
          ));
      allow delete: if hasRole('super_admin');
    }

    match /driverRatings/{ratingId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.customerId == request.auth.uid) ||
        (signedIn() && resource.data.driverId == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.customerId == request.auth.uid;
      allow update: if isAdmin() &&
        !request.resource.data.diff(resource.data).changedKeys().hasAny(['starRating']);
      allow delete: if false;
    }

    match /driverPerformanceMetrics/{metricId} {
      allow read: if isAdmin() || (signedIn() && metricId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /deliveryRequests/{deliveryId} {
      allow read: if isAdmin() ||
        isOwnDelivery(deliveryId) ||
        isAssignedRider() ||
        isAvailableRiderJob();
      allow create: if isAdmin() || isCreatingOwnDelivery();
      allow update: if isAdmin() ||
        isOwnDeliveryUpdate() ||
        isAssignedRiderUpdate();
      allow delete: if hasRole('super_admin');

      match /tracking/{trackingId} {
        allow read: if canReadDeliveryTracking(deliveryId);
        allow create, update: if trackingId == 'liveLocation' &&
          canWriteOwnLiveLocation(deliveryId);
        allow delete: if isAdmin();
      }
    }

    match /webSenderRequests/{requestId} {
      allow read, update: if isAdmin() ||
        (
          signedIn() &&
          resource.data.senderId == request.auth.uid &&
          !request.resource.data.diff(resource.data).changedKeys().hasAny(['iris'])
        );
      allow create: if isAdmin() || isCreatingOwnDelivery();
      allow delete: if hasRole('super_admin');
    }

    match /irisPrivate/{requestId} {
      allow read: if isAdmin();
      allow create: if isAdmin() ||
        isSenderPrivateCreate() ||
        isAssignedRiderPrivateCreate();
      allow update: if isAdmin() || isAssignedRiderPrivateUpdate();
      allow delete: if hasRole('super_admin');
    }

    match /irisReferrals/{referralId} {
      allow read, write: if isAdmin();
      allow delete: if hasRole('super_admin');
    }

    match /chats/{chatId} {
      allow read: if isAdmin() || isParticipant();
      // Conversation lifecycle, messages, read state and typing are enforced
      // through trusted callables to keep delivery membership authoritative.
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if isAdmin() ||
          (signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        allow create: if false;
        allow update, delete: if false;
      }
    }

    match /users/{userId} {
      allow read: if isAdmin() || ownsSenderRecord(userId);
      allow create: if (isAdmin() || ownsSenderRecord(userId)) &&
        !request.resource.data.keys().hasAny([
          'isLegend',
          'legendNumber',
          'legendAwardedAt',
          'legendSource',
          'legendDeliveryId',
          'senderTrustPoints',
          'trustPoints',
          'senderTier',
          'trustTier',
          'senderTrustFrozen',
          'senderTrustBreakdown'
        ]);
      allow update: if hasRole('super_admin') ||
        (isAdmin() && !changesLegendFields()) ||
        (ownsSenderRecord(userId) && !changesLegendFields() && !changesSenderTrustFields());
      allow delete: if hasRole('super_admin');

      match /savedAddresses/{addressId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update, delete: if false;
      }
    }

    match /senderTrustEvents/{eventId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /referralCodes/{code} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /referrals/{referralId} {
      allow read: if isAdmin() ||
        (signedIn() && (
          resource.data.referrerUserId == request.auth.uid ||
          resource.data.referredUserId == request.auth.uid
        ));
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if hasRole('super_admin');
    }

    match /giftRecommendationRepository/{itemId} {
      allow read, create, update: if isAdmin();
      allow delete: if hasRole('super_admin');
    }

    match /emailQueue/{emailId} {
      allow read, create: if isAdmin();
      allow update, delete: if hasRole('super_admin');
    }

    match /platformStats/legends {
      allow read: if isAdmin();
      allow write: if hasRole('super_admin');
    }

    match /senders/{senderId} {
      allow read: if isAdmin() || ownsSenderRecord(senderId);
      allow create, update: if isAdmin() || ownsSenderRecord(senderId);
      allow delete: if hasRole('super_admin');
    }

    match /history/{historyId} {
      allow read: if isAdmin() || isOwnDelivery(historyId) || isAssignedRider();
      allow create, update: if isAdmin();
      allow delete: if hasRole('super_admin');
    }

    match /prescriptionPickups/{pickupId} {
      allow read, update, delete: if isAdmin() ||
        (signedIn() && resource.data.senderId == request.auth.uid) ||
        (signedIn() && resource.data.userId == request.auth.uid) ||
        isAssignedRider();
      allow create: if isAdmin() ||
        (signedIn() && request.resource.data.senderId == request.auth.uid) ||
        (signedIn() && request.resource.data.userId == request.auth.uid);
    }

    match /healthPlusProfiles/{profileId} {
      allow read, update: if isAdmin() ||
        (signedIn() && resource.data.senderId == request.auth.uid) ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() ||
        (signedIn() && request.resource.data.senderId == request.auth.uid) ||
        (signedIn() && request.resource.data.userId == request.auth.uid);
      allow delete: if hasRole('super_admin');
    }

    match /recurringPickupSchedules/{scheduleId} {
      allow read, update: if isAdmin() ||
        (signedIn() && resource.data.senderId == request.auth.uid) ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() ||
        (signedIn() && request.resource.data.senderId == request.auth.uid) ||
        (signedIn() && request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /healthPlusNotifications/{notificationId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.senderId == request.auth.uid) ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() ||
        (signedIn() && request.resource.data.senderId == request.auth.uid) ||
        (signedIn() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /healthPlusUsageEvents/{eventId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.senderId == request.auth.uid) ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() ||
        (signedIn() && request.resource.data.senderId == request.auth.uid) ||
        (signedIn() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }

    match /riderApplications/{applicationId} {
      allow read, update: if isAdmin() ||
        (signedIn() && resource.data.riderId == request.auth.uid);
      allow create: if isAdmin() ||
        (signedIn() && request.resource.data.riderId == request.auth.uid);
      allow delete: if hasRole('super_admin');
    }

    match /riderOnboardingEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || isRiderAccount();
      allow update, delete: if false;
    }

    match /riderEarnings/{riderId} {
      allow read: if isAdmin() || (signedIn() && riderId == request.auth.uid);
      allow create, update: if isAdmin() || (signedIn() && riderId == request.auth.uid);
      allow delete: if hasRole('super_admin');
    }

    match /riderWalletTransactions/{transactionId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.riderId == request.auth.uid);
      allow create: if isAdmin() ||
        (signedIn() && request.resource.data.riderId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if hasRole('super_admin');
    }

    match /payoutRequests/{requestId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.riderId == request.auth.uid);
      allow create: if isAdmin() ||
        (signedIn() &&
          request.resource.data.riderId == request.auth.uid &&
          payoutRawBankFieldsAbsent(request.resource.data) &&
          request.resource.data.payoutFeePayer == 'rider');
      allow update: if isAdmin();
      allow delete: if hasRole('super_admin');
    }

    match /riderBankAccounts/{riderId} {
      allow read: if isAdmin() || (signedIn() && riderId == request.auth.uid);
      allow create, update: if isAdmin();
      allow delete: if hasRole('super_admin');
    }

    match /riderDocuments/{documentId} {
      allow read, update: if isAdmin() ||
        (signedIn() && resource.data.riderId == request.auth.uid);
      allow create: if isAdmin() ||
        (signedIn() && request.resource.data.riderId == request.auth.uid);
      allow delete: if hasRole('super_admin');
    }

    match /{document=**} {
      allow read: if isAdmin();
      allow write: if hasRole('super_admin');
    }
  }
}
