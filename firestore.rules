rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn() && (
        request.auth.token.get('adminRole', '') == role ||
        request.auth.token.get('role', '') == role ||
        (request.auth.token.get('roles', []) is list && role in request.auth.token.get('roles', []))
      );
    }

    function hasAnyRole(roles) {
      return signedIn() && (
        request.auth.token.get('adminRole', '') in roles ||
        request.auth.token.get('role', '') in roles ||
        (request.auth.token.get('roles', []) is list && request.auth.token.get('roles', []).hasAny(roles))
      );
    }

    function isAdmin() {
      return hasAnyRole([
        'super_admin', 'admin', 'operations', 'operations_admin',
        'support', 'customer_support', 'support_agent',
        'finance', 'finance_admin', 'driver_manager', 'rider_manager',
        'reviewer', 'rider_reviewer', 'risk', 'risk_reviewer',
        'analytics', 'analytics_viewer'
      ]);
    }

    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    function isOperationsAdmin() {
      return hasAnyRole(['super_admin', 'admin', 'operations', 'operations_admin']);
    }

    function isSupportAdmin() {
      return hasAnyRole([
        'super_admin', 'admin', 'operations', 'operations_admin',
        'support', 'customer_support', 'support_agent'
      ]);
    }

    function isFinanceAdmin() {
      return hasAnyRole(['super_admin', 'finance', 'finance_admin']);
    }

    function isDriverManager() {
      return hasAnyRole([
        'super_admin', 'admin', 'operations', 'operations_admin',
        'driver_manager', 'rider_manager', 'reviewer', 'rider_reviewer'
      ]);
    }

    function isRiskAdmin() {
      return hasAnyRole(['super_admin', 'risk', 'risk_reviewer']);
    }

    function isAnalyticsAdmin() {
      return hasAnyRole(['super_admin', 'analytics', 'analytics_viewer']);
    }

    function ownsSenderRecord(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function canReadSenderTrustEvent() {
      return isAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid);
    }

    function authEmail() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email
        : '';
    }

    function isBusinessMemberRecord() {
      return signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.createdByUserId == request.auth.uid ||
        (
          resource.data.teamMemberIds is list &&
          (
            request.auth.uid in resource.data.teamMemberIds ||
            authEmail() in resource.data.teamMemberIds
          )
        )
      );
    }

    function canReadBusinessId(businessId) {
      return signedIn() &&
        businessId is string &&
        businessId.size() > 0 &&
        exists(/databases/$(database)/documents/businessAccounts/$(businessId)) &&
        (
          get(/databases/$(database)/documents/businessAccounts/$(businessId)).data.ownerUid == request.auth.uid ||
          get(/databases/$(database)/documents/businessAccounts/$(businessId)).data.createdByUserId == request.auth.uid ||
          (
            get(/databases/$(database)/documents/businessAccounts/$(businessId)).data.teamMemberIds is list &&
            (
              request.auth.uid in get(/databases/$(database)/documents/businessAccounts/$(businessId)).data.teamMemberIds ||
              authEmail() in get(/databases/$(database)/documents/businessAccounts/$(businessId)).data.teamMemberIds
            )
          )
        );
    }

    function changesLegendFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'isLegend',
        'legendNumber',
        'legendAwardedAt',
        'legendSource',
        'legendDeliveryId'
      ]);
    }

    function isRiderAccount() {
      return signedIn() && (
        hasRole('super_admin') ||
        exists(/databases/$(database)/documents/riderProfiles/$(request.auth.uid))
      );
    }

    function isOwnDelivery(deliveryId) {
      return signedIn() && (
        deliveryId == request.auth.uid ||
        resource.data.senderId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
    }

    function isAssignedRider() {
      return signedIn() && (
        resource.data.get('riderId', '') == request.auth.uid ||
        resource.data.get('driverId', '') == request.auth.uid ||
        resource.data.get('assignedRiderId', '') == request.auth.uid ||
        resource.data.get('assignedDriverId', '') == request.auth.uid
      );
    }

    function isCreatingOwnDelivery() {
      return signedIn() && (
        request.resource.data.senderId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
    }

    function protectedDeliveryFields() {
      return [
        'status',
        'deliveryStatus',
        'deliveryStage',
        'paymentStatus',
        'paidAmount',
        'amountPaid',
        'pricePaid',
        'paymentIntentId',
        'stripePaymentIntentId',
        'stripeCheckoutSessionId',
        'stripeSessionId',
        'paymentSessionId',
        'paymentCompletedAt',
        'paidAt',
        'finalAmount',
        'finalChargeAmount',
        'finalChargeableAmount',
        'quotedAmount',
        'quotedPrice',
        'authoritativeQuote',
        'pricingSnapshot',
        'priceBreakdown',
        'refundStatus',
        'refundAmount',
        'refundReviewStatus',
        'state',
        'senderId',
        'userId',
        'senderEmail',
        'riderId',
        'assignedRiderId',
        'price',
        'total',
        'amount',
        'payment',
        'rothAppliedAmount',
        'remainingAmount',
        'cancellationSettlementStatus',
        'cancellationRequestedAt',
        'cancellationRequestedBy',
        'cancellationPolicy',
        'cancellationFinancial',
        'cancellationSettlement',
        'broadcastBlocked',
        'broadcastBlockReason',
        'matchingStatus',
        'dispatchStatus',
        'arrivedAt',
        'pickupArrivedAt',
        'arrivedAtPickupAt',
        'dropoffArrivedAt',
        'waiting',
        'cancellationFee',
        'cancellationCharge',
        'cancellationChargeStatus',
        'riderEarnings',
        'driverPayout',
        'payoutStatus',
        'ledgerRef',
        'ledgerReferences',
        'trustScore',
        'trustAwards',
        'trustPointsAwarded',
        'rank',
        'riderRank',
        'weightKg',
        'finalWeightKg',
        'confirmedWeightKg',
        'completionState',
        'completedAt',
        'pinVerified',
        'collectionPinVerified',
        'deliveryPinVerified',
        'arrivalState',
        'noShowState',
        'adminInvestigation',
        'adminReview',
        'serverAudit',
        'auditTrail'
      ];
    }

    function protectedFinancialCreateFields() {
      return [
        'status',
        'deliveryStatus',
        'deliveryStage',
        'paymentStatus',
        'paidAmount',
        'amountPaid',
        'pricePaid',
        'paymentIntentId',
        'stripePaymentIntentId',
        'stripeCheckoutSessionId',
        'stripeSessionId',
        'paymentSessionId',
        'paymentCompletedAt',
        'paidAt',
        'refundStatus',
        'refundAmount',
        'refundReviewStatus',
        'cancellationFee',
        'cancellationCharge',
        'cancellationChargeStatus',
        'riderEarnings',
        'driverPayout',
        'payoutStatus',
        'ledgerRef',
        'ledgerReferences',
        'trustScore',
        'trustAwards',
        'rank',
        'riderRank',
        'completionState',
        'completedAt',
        'pinVerified',
        'collectionPinVerified',
        'deliveryPinVerified',
        'arrivalState',
        'noShowState',
        'adminInvestigation',
        'adminReview',
        'serverAudit',
        'auditTrail',
        'quotedPrice',
        'authoritativeQuote',
        'pricingSnapshot',
        'priceBreakdown',
        'paymentRecordId',
        'stripeCustomerId'
      ];
    }

    function directContactFields() {
      return [
        'phone',
        'phoneNumber',
        'mobile',
        'contactNumber',
        'tel',
        'userPhone',
        'riderPhone',
        'senderPhone',
        'driverPhone',
        'courierPhone',
        'receiverPhone'
      ];
    }

    function publicDeliveryHasNoDirectContact(data) {
      return !data.keys().hasAny(directContactFields()) &&
        (!data.keys().hasAny(['pickupDetails']) ||
          !(data.pickupDetails is map) ||
          !data.pickupDetails.keys().hasAny(directContactFields())) &&
        (!data.keys().hasAny(['dropoffDetails']) ||
          !(data.dropoffDetails is map) ||
          !data.dropoffDetails.keys().hasAny(directContactFields())) &&
        (!data.keys().hasAny(['recipient']) ||
          !(data.recipient is map) ||
          !data.recipient.keys().hasAny(directContactFields()));
    }

    function isSafeDeliveryCreate() {
      return isCreatingOwnDelivery() &&
        !request.resource.data.keys().hasAny(['iris']) &&
        publicDeliveryHasNoDirectContact(request.resource.data) &&
        !request.resource.data.keys().hasAny(protectedFinancialCreateFields());
    }

    function isOwnDeliveryUpdate() {
      return isOwnDelivery('') &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['iris']) &&
        publicDeliveryHasNoDirectContact(request.resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedDeliveryFields()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'recipientNotes', 'senderNote', 'updatedAt'
        ]);
    }

    function isAssignedRiderUpdate() {
      return isAssignedRider() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'rejectedByRiders',
          'ignoredByRiders',
          'rejectedAt',
          'ignoredAt',
          'updatedAt'
        ]);
    }

    function riderAdminOnlyFields() {
      return [
        'approvalStatus',
        'verificationStatus',
        'adminApprovalStatus',
        'adminReviewStatus',
        'approvedAt',
        'approvedBy',
        'rejectedAt',
        'rejectedBy',
        'rejectionReason',
        'driverStatus',
        'role',
        'roles',
        'rank',
        'riderRank',
        'trustPoints',
        'trustScore',
        'rating',
        'averageRating',
        'completedDeliveries',
        'availableBalance',
        'lifetimeEarnings',
        'totalAmountEarned',
        'stripeConnectAccountId',
        'stripeAccountId',
        'stripePayoutsEnabled',
        'payoutPaused',
        'internalAccess',
        'founderRider',
        'isAdmin',
        'admin',
        'publicRiderId'
      ];
    }

    function userAdminOnlyRoleFields() {
      return [
        'starterRothGrantStatus',
        'starterRothGrantedAt',
        'starterRothAmount',
        'starterRothTransactionId',
        'roles',
        'adminRole',
        'isAdmin',
        'admin'
      ];
    }

    function isSafeSenderRoleValue(value) {
      return value in ['sender', 'customer', 'user', 'client', 'member'];
    }

    function hasUnsafeSelfUserRoleCreate() {
      return request.resource.data.keys().hasAny(['role']) &&
        !isSafeSenderRoleValue(request.resource.data.role);
    }

    function hasUnsafeSelfUserTypeCreate() {
      return request.resource.data.keys().hasAny(['userType']) &&
        !isSafeSenderRoleValue(request.resource.data.userType);
    }

    function hasUnsafeSelfUserRoleUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) &&
        !isSafeSenderRoleValue(request.resource.data.role);
    }

    function hasUnsafeSelfUserTypeUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['userType']) &&
        !isSafeSenderRoleValue(request.resource.data.userType);
    }

    function senderPrivilegedFields() {
      return [
        'role',
        'roles',
        'adminRole',
        'isAdmin',
        'admin',
        'verificationStatus',
        'approvalStatus',
        'dispatchEligible',
        'accountStatus',
        'permissions',
        'claims',
        'customClaims',
        'financialAuthority',
        'paymentAuthority',
        'reviewStatus',
        'adminReviewStatus'
      ];
    }

    function isSafeSenderSelfCreate(senderId) {
      return ownsSenderRecord(senderId) &&
        !request.resource.data.keys().hasAny(senderPrivilegedFields()) &&
        !hasUnsafeSelfUserTypeCreate();
    }

    function isSafeSenderSelfUpdate(senderId) {
      return ownsSenderRecord(senderId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(senderPrivilegedFields()) &&
        !hasUnsafeSelfUserTypeUpdate();
    }

    function riderSelfWritableFields() {
      return [
        'name',
        'uid',
        'email',
        'emailVerified',
        'emailVerifiedAt',
        'fullName',
        'firstName',
        'lastName',
        'handle',
        'username',
        'dateOfBirth',
        'gender',
        'homeAddress',
        'phone',
        'phoneNumber',
        'phoneVerified',
        'phoneVerifiedAt',
        'locationEnabled',
        'position',
        'fcmToken',
        'photoURL',
        'photoUrl',
        'photoPath',
        'profilePhoto',
        'profilePhotoUrl',
        'profileThumbnailUrl',
        'profilePhotoPath',
        'profileThumbnailPath',
        'profilePhotoVersion',
        'profilePhotoMetadata',
        'photoUpdatedAt',
        'profilePhotoUpdatedAt',
        'profilePhotoUploadedAt',
        'updatedAt'
      ];
    }

    function isSafeRiderSelfUpdate(driverId) {
      return signedIn() && request.auth.uid == driverId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(riderAdminOnlyFields()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(riderSelfWritableFields());
    }

    function deliveryFor(deliveryId) {
      return get(/databases/$(database)/documents/deliveryRequests/$(deliveryId)).data;
    }

    function canReadDeliveryTracking(deliveryId) {
      return signedIn() && (
        isAdmin() ||
        deliveryFor(deliveryId).senderId == request.auth.uid ||
        deliveryFor(deliveryId).userId == request.auth.uid ||
        deliveryFor(deliveryId).riderId == request.auth.uid ||
        deliveryFor(deliveryId).driverId == request.auth.uid ||
        deliveryFor(deliveryId).assignedDriverId == request.auth.uid
      );
    }

    function assignedRiderForDelivery(deliveryId) {
      return signedIn() && (
        deliveryFor(deliveryId).riderId == request.auth.uid ||
        deliveryFor(deliveryId).driverId == request.auth.uid ||
        deliveryFor(deliveryId).assignedDriverId == request.auth.uid
      );
    }

    function isTrackableDelivery(deliveryId) {
      return !([
        'completed',
        'delivered',
        'cancelled',
        'canceled',
        'expired',
        'archived',
        'archived_stale'
      ].hasAny([
        deliveryFor(deliveryId).status,
        deliveryFor(deliveryId).deliveryStatus,
        deliveryFor(deliveryId).deliveryStage
      ]));
    }

    function validRiderLiveLocationMap() {
      return request.resource.data.riderLiveLocation is map &&
        request.resource.data.riderLiveLocation.keys().hasOnly([
          'geopoint',
          'latitude',
          'longitude',
          'accuracy',
          'heading',
          'speed',
          'freshness',
          'deliveryState',
          'updatedAt'
        ]) &&
        request.resource.data.riderLiveLocation.geopoint is latlng &&
        request.resource.data.riderLiveLocation.latitude is number &&
        request.resource.data.riderLiveLocation.longitude is number &&
        request.resource.data.riderLiveLocation.accuracy is number &&
        request.resource.data.riderLiveLocation.heading is number &&
        request.resource.data.riderLiveLocation.speed is number &&
        request.resource.data.riderLiveLocation.freshness is string &&
        request.resource.data.riderLiveLocation.deliveryState is string &&
        request.resource.data.riderLiveLocation.updatedAt is timestamp;
    }

    function validLiveTrackingPayload(deliveryId) {
      return request.resource.data.riderId == request.auth.uid &&
        request.resource.data.activeDeliveryId == deliveryId &&
        request.resource.data.deliveryId == deliveryId &&
        request.resource.data.latitude is number &&
        request.resource.data.longitude is number &&
        request.resource.data.accuracy is number &&
        request.resource.data.heading is number &&
        request.resource.data.speed is number &&
        request.resource.data.status is string &&
        request.resource.data.trackingStatus == 'live' &&
        request.resource.data.deliveryState is string &&
        request.resource.data.freshness == 'fresh' &&
        request.resource.data.clientRecordedAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.freshnessUpdatedAt is timestamp &&
        validRiderLiveLocationMap() &&
        request.resource.data.keys().hasOnly([
          'riderId',
          'activeDeliveryId',
          'deliveryId',
          'latitude',
          'longitude',
          'accuracy',
          'heading',
          'speed',
          'status',
          'trackingStatus',
          'deliveryState',
          'freshness',
          'clientRecordedAt',
          'updatedAt',
          'freshnessUpdatedAt',
          'riderLiveLocation'
        ]);
    }

    function validStoppedTrackingPayload(deliveryId) {
      return request.resource.data.riderId == request.auth.uid &&
        request.resource.data.activeDeliveryId == deliveryId &&
        request.resource.data.deliveryId == deliveryId &&
        request.resource.data.trackingStatus == 'stopped' &&
        request.resource.data.status is string &&
        request.resource.data.deliveryState is string &&
        request.resource.data.freshness == 'stopped' &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.freshnessUpdatedAt is timestamp &&
        request.resource.data.keys().hasOnly([
          'riderId',
          'activeDeliveryId',
          'deliveryId',
          'trackingStatus',
          'status',
          'deliveryState',
          'freshness',
          'updatedAt',
          'freshnessUpdatedAt'
        ]);
    }

    function validActiveDeliveryLivePayload(deliveryId) {
      return request.resource.data.deliveryId == deliveryId &&
        request.resource.data.riderId == request.auth.uid &&
        request.resource.data.status is string &&
        request.resource.data.deliveryState is string &&
        request.resource.data.trackingStatus == 'live' &&
        request.resource.data.freshness == 'fresh' &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.freshnessUpdatedAt is timestamp &&
        validRiderLiveLocationMap() &&
        request.resource.data.keys().hasOnly([
          'deliveryId',
          'riderId',
          'status',
          'deliveryState',
          'trackingStatus',
          'freshness',
          'riderLiveLocation',
          'updatedAt',
          'freshnessUpdatedAt'
        ]);
    }

    function validActiveDeliveryStoppedPayload(deliveryId) {
      return validStoppedTrackingPayload(deliveryId);
    }

    function canWriteOwnLiveLocation(deliveryId) {
      return signedIn() &&
        assignedRiderForDelivery(deliveryId) &&
        isTrackableDelivery(deliveryId) &&
        (
          validLiveTrackingPayload(deliveryId) ||
          validStoppedTrackingPayload(deliveryId)
        );
    }

    function canWriteActiveDelivery(deliveryId) {
      return signedIn() &&
        assignedRiderForDelivery(deliveryId) &&
        isTrackableDelivery(deliveryId) &&
        (
          validActiveDeliveryLivePayload(deliveryId) ||
          validActiveDeliveryStoppedPayload(deliveryId)
        );
    }

    function isParticipant() {
      return signedIn() &&
        resource.data.participants is list &&
        request.auth.uid in resource.data.participants;
    }

    match /adminUsers/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || (isSuperAdmin()));
      allow write: if false;
    }

    match /adminAuditLogs/{logId} {
      allow read: if (isSuperAdmin() || isOperationsAdmin() || isFinanceAdmin() || isSupportAdmin() || isDriverManager() || isRiskAdmin());
      allow create, update, delete: if false;
    }

    match /adminNotes/{noteId} {
      allow read: if (isSupportAdmin());
      allow create, update, delete: if false;
    }

    match /supportTickets/{ticketId} {
      allow read: if (isSupportAdmin());
      allow write: if false;
      allow create: if request.resource.data.channel == 'web_live_chat' &&
        request.resource.data.keys().hasOnly([
          'channel',
          'status',
          'priority',
          'name',
          'email',
          'message',
          'lastMessage',
          'lastMessageAt',
          'adminUnreadCount',
          'pageUrl',
          'chatId',
          'userId',
          'createdAt',
          'updatedAt'
        ]) &&
        (!request.resource.data.keys().hasAny(['chatId']) ||
          request.resource.data.chatId is string) &&
        (!request.resource.data.keys().hasAny(['userId']) ||
          (signedIn() && request.resource.data.userId == request.auth.uid));
    }

    match /notifications/{notificationId} {
      allow read: if (isSupportAdmin()) ||
        (signedIn() && resource.data.recipientId == request.auth.uid);
      allow update: if false;
      allow create: if false;
      allow delete: if false;
    }

    match /businessAccounts/{businessId} {
      allow read: if (isOperationsAdmin() || isFinanceAdmin()) || isBusinessMemberRecord();
      allow write: if false;
    }

    match /businessWorkspaces/{businessId} {
      allow read: if (isOperationsAdmin() || isFinanceAdmin()) || canReadBusinessId(businessId);
      allow write: if false;
    }

    match /businessSettings/{businessId} {
      allow read: if (isOperationsAdmin() || isFinanceAdmin()) || canReadBusinessId(businessId);
      allow write: if false;
    }

    match /businessAnalytics/{businessId} {
      allow read: if (isOperationsAdmin() || isFinanceAdmin()) || canReadBusinessId(businessId);
      allow write: if false;
    }

    match /business_wallets/{businessId} {
      allow read: if (isFinanceAdmin()) || canReadBusinessId(businessId);
      allow write: if false;
    }

    match /businessMemberships/{membershipId} {
      allow read: if (isOperationsAdmin() || isFinanceAdmin()) ||
        (signedIn() && resource.data.userId == request.auth.uid) ||
        canReadBusinessId(resource.data.businessId);
      allow write: if false;
    }

    match /businessJoinRequests/{requestId} {
      allow read: if (isOperationsAdmin() || isFinanceAdmin()) ||
        (signedIn() && resource.data.userId == request.auth.uid) ||
        canReadBusinessId(resource.data.businessId);
      allow write: if false;
    }

    match /businessInvoices/{invoiceId} {
      allow read: if (isFinanceAdmin()) || canReadBusinessId(resource.data.businessId);
      allow write: if false;
    }

    match /businessAuditLogs/{logId} {
      allow read: if (isFinanceAdmin()) || canReadBusinessId(resource.data.businessId);
      allow write: if false;
    }

    match /giftsWaitlist/{entryId} {
      allow create: if request.resource.data.source == 'gifts-coming-soon' &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 3 &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.keys().hasOnly([
          'name',
          'email',
          'source',
          'createdAt'
        ]);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /giftRequests/{giftRequestId} {
      allow create: if false;
      allow read: if (isSupportAdmin()) ||
        canReadBusinessId(resource.data.businessId) ||
        (signedIn() && resource.data.senderId == request.auth.uid);
      allow update: if false;
      allow delete: if false;
    }

    match /giftPaymentDrafts/{giftDraftId} {
      allow create: if signedIn() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.status == 'draft' &&
        request.resource.data.paymentStatus == 'payment_pending' &&
        request.resource.data.grossBudget is number &&
        request.resource.data.grossBudget >= 50;
      allow read: if isAdmin() ||
        (signedIn() && resource.data.senderId == request.auth.uid);
      allow update, delete: if false;
    }

    match /giftBrands/{brandId} {
      allow read: if (isSupportAdmin());
      allow create, update: if false;
      allow delete: if false;
    }

    match /giftCampaignParticipants/{participantId} {
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow read: if (isSupportAdmin()) ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if signedIn() && resource.data.userId == request.auth.uid &&
          !request.resource.data.diff(resource.data).changedKeys().hasAny([
            'matchedParticipantId',
            'matchScore',
            'matchReason',
            'matchStatus',
            'matchLockedAt',
            'matchApprovedBy'
          ]);
      allow delete: if false;
    }

    match /giftCampaignMatches/{matchId} {
      allow read: if (isSupportAdmin());
      allow create, update: if false;
      allow delete: if false;
    }

    match /irisLearningOutliers/{outlierId} {
      allow create: if signedIn() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.status == 'pending_review';
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /irisLearningCases/{caseId} {
      allow read: if isAdmin();
      allow create, update: if false;
      allow delete: if false;
    }

    match /iris_learning_review_candidates/{candidateId} {
      allow read: if isAdmin();
      allow update: if false;
      allow create: if false;
      allow delete: if false;
    }

    match /irisCanonicalObjects/{objectId} {
      allow read: if isAdmin();
      allow create, update: if false;
      allow delete: if false;
    }

    match /irisEvidence/{evidenceId} {
      allow read: if isAdmin();
      allow create, update: if false;
      allow delete: if false;
    }

    match /irisPolicies/{policyId} {
      allow read: if isAdmin();
      allow create, update: if false;
      allow delete: if false;
    }

    match /deliveryAdjustments/{adjustmentId} {
      allow read: if (isOperationsAdmin() || isFinanceAdmin()) ||
        (signedIn() && resource.data.senderId == request.auth.uid) ||
        (signedIn() && resource.data.riderId == request.auth.uid);
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if isFinanceAdmin();
      allow write: if false;
    }

    match /healthPlusPayments/{paymentId} {
      allow read: if isFinanceAdmin() ||
        hasRole('operations_admin') ||
        (signedIn() && resource.data.senderId == request.auth.uid) ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /riderPresence/{riderId} {
      allow read: if (isDriverManager()) || (signedIn() && request.auth.uid == riderId);
      allow write: if false;
    }

    match /riderProfiles/{driverId} {
      allow read: if (isDriverManager()) || (signedIn() && request.auth.uid == driverId);
      allow create: if false;
      allow update: if isSafeRiderSelfUpdate(driverId);
      allow delete: if false;
    }

    match /riders/{driverId} {
      allow read: if (isDriverManager()) || (signedIn() && request.auth.uid == driverId);
      allow create: if false;
      allow update: if isSafeRiderSelfUpdate(driverId);
      allow delete: if false;
    }

    match /publicRiderIds/{publicRiderId} {
      allow read: if (isDriverManager());
      allow write: if false;
    }

    match /publishedDriverRatings/{ratingId} {
      allow read: if (isSupportAdmin() || isRiskAdmin()) || (signedIn() &&
        (resource.data.customerId == request.auth.uid || resource.data.driverId == request.auth.uid));
      allow write: if false;
    }
    match /ratingPrivateFeedback/{ratingId} {
      allow read: if (isSupportAdmin() || isRiskAdmin());
      allow write: if false;
    }
    function ratingHasCompletedDelivery() {
      let delivery = get(/databases/$(database)/documents/deliveryRequests/$(resource.data.deliveryId)).data;
      return delivery.get('deliveryState', delivery.get('status', '')) in ['completed', 'complete', 'delivered'] &&
        delivery.get('paymentStatus', '') in ['paid', 'succeeded', 'success'] &&
        delivery.get('senderId', delivery.get('userId', delivery.get('customerId', ''))) == resource.data.customerId &&
        delivery.get('riderId', delivery.get('driverId', delivery.get('assignedRiderId', delivery.get('assignedDriverId', '')))) == resource.data.driverId &&
        !delivery.get('isTest', false) && !delivery.get('testData', false);
    }
    match /driverRatings/{ratingId} {
      allow read: if (isSupportAdmin() || isRiskAdmin()) ||
        (signedIn() && ratingHasCompletedDelivery() &&
          (resource.data.customerId == request.auth.uid || resource.data.driverId == request.auth.uid));
      // Ratings and moderation are authored by backend callables.
      allow create, update, delete: if false;
    }

    match /deliveryTips/{tipId} {
      allow read: if (isFinanceAdmin()) || (signedIn() &&
        (resource.data.senderId == request.auth.uid || resource.data.riderId == request.auth.uid));
      allow write: if false;
    }

    match /driverPerformanceMetrics/{metricId} {
      allow read: if (isDriverManager()) || (signedIn() && metricId == request.auth.uid);
      allow write: if false;
    }

    match /dispatchInspections/{inspectionId} {
      allow read: if (isOperationsAdmin() || isRiskAdmin());
      allow write: if false;
      allow delete: if false;
    }

    match /riderOfferAuthorizations/{riderId}/{nested=**} {
      allow read, write: if false;
    }
    function offerIrisUnchanged(riderId, deliveryId) {
      let authority = get(/databases/$(database)/documents/riderOfferAuthorizations/$(riderId)/jobs/$(deliveryId)).data;
      let path = /databases/$(database)/documents/irisPrivate/$(authority.irisDocumentId);
      return authority.irisPrivate == null ? !exists(path) : exists(path) && get(path).data == authority.irisPrivate;
    }
    match /riderOfferProjections/{riderId}/offers/{deliveryId} {
      allow get: if signedIn() && request.auth.uid == riderId &&
        resource.data.expiresAt > request.time && offerIrisUnchanged(riderId, deliveryId) &&
        get(/databases/$(database)/documents/riderOfferAuthorizations/$(riderId)/jobs/$(deliveryId)).data.expiresAt > request.time &&
        get(/databases/$(database)/documents/riderProfiles/$(riderId)).data == get(/databases/$(database)/documents/riderOfferAuthorizations/$(riderId)/jobs/$(deliveryId)).data.profile &&
        get(/databases/$(database)/documents/riders/$(riderId)).data == get(/databases/$(database)/documents/riderOfferAuthorizations/$(riderId)/jobs/$(deliveryId)).data.rider &&
        get(/databases/$(database)/documents/riderPresence/$(riderId)).data == get(/databases/$(database)/documents/riderOfferAuthorizations/$(riderId)/jobs/$(deliveryId)).data.presence &&
        get(/databases/$(database)/documents/deliveryRequests/$(deliveryId)).data == get(/databases/$(database)/documents/riderOfferAuthorizations/$(riderId)/jobs/$(deliveryId)).data.delivery;
      allow list, write: if false;
    }

    match /deliveryRequests/{deliveryId} {
      allow read: if (isOperationsAdmin() || isSupportAdmin() || isFinanceAdmin() || isDriverManager() || isRiskAdmin()) ||
        isOwnDelivery(deliveryId) ||
        isAssignedRider() ||
        canReadBusinessId(resource.data.businessId);
      allow create: if false;
      allow update: if isOwnDeliveryUpdate() ||
        isAssignedRiderUpdate();
      allow delete: if false;

      match /tracking/{trackingId} {
        allow read: if canReadDeliveryTracking(deliveryId);
        allow create, update: if trackingId == 'liveLocation' &&
          canWriteOwnLiveLocation(deliveryId);
        allow delete: if false;
      }
    }

    match /deliveryRequestsPrivate/{deliveryId} {
      allow read, write: if false;
    }

    match /activeDeliveries/{deliveryId} {
      allow read: if canReadDeliveryTracking(deliveryId);
      allow create, update: if canWriteActiveDelivery(deliveryId);
      allow delete: if false;
    }

    match /webSenderRequests/{requestId} {
      allow read: if isAdmin() || (signedIn() && resource.data.senderId == request.auth.uid);
      allow create: if isCreatingOwnDelivery() &&
        !request.resource.data.keys().hasAny(['iris']) &&
        request.resource.data.keys().hasOnly(['senderId', 'userId', 'packageDescription', 'createdAt', 'updatedAt']);
      allow update: if signedIn() && resource.data.senderId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['packageDescription', 'updatedAt']);
      allow delete: if false;
    }

    match /irisPrivate/{requestId} {
      allow read: if isAdmin();
      allow create, update: if false;
      allow delete: if false;
    }

    match /irisReferrals/{referralId} {
      allow read: if isAdmin();
      allow write: if false;
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if (isSupportAdmin()) || isParticipant();
      allow create, update: if false;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if (isSupportAdmin()) ||
          (signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        allow delete: if false;
      }
    }

    match /users/{userId} {
      allow read: if (isOperationsAdmin() || isSupportAdmin() || isFinanceAdmin() || isRiskAdmin()) || ownsSenderRecord(userId);
      allow create: if ownsSenderRecord(userId) &&
        !request.resource.data.keys().hasAny([
          'isLegend',
          'legendNumber',
          'legendAwardedAt',
          'legendSource',
          'legendDeliveryId'
        ]) &&
        !request.resource.data.keys().hasAny(userAdminOnlyRoleFields()) &&
        !hasUnsafeSelfUserRoleCreate() &&
        !hasUnsafeSelfUserTypeCreate();
      allow update: if ownsSenderRecord(userId) &&
          !changesLegendFields() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(userAdminOnlyRoleFields()) &&
          !hasUnsafeSelfUserRoleUpdate() &&
          !hasUnsafeSelfUserTypeUpdate();
      allow delete: if false;

      match /giftStories/{giftStoryId} {
        allow read: if (isOperationsAdmin() || isSupportAdmin() || isFinanceAdmin() || isRiskAdmin()) || ownsSenderRecord(userId);
        allow create, update, delete: if false;
      }
    }

    match /senderTrustEvents/{eventId} {
      allow read: if canReadSenderTrustEvent();
      allow create, update, delete: if false;
    }

    match /{path=**}/senderTrustEvents/{eventId} {
      allow read: if canReadSenderTrustEvent();
      allow create, update, delete: if false;
    }

    match /platformStats/legends {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /senders/{senderId} {
      allow read: if (isOperationsAdmin() || isSupportAdmin() || isFinanceAdmin() || isRiskAdmin()) || ownsSenderRecord(senderId);
      allow create: if isSafeSenderSelfCreate(senderId);
      allow update: if isSafeSenderSelfUpdate(senderId);
      allow delete: if false;
    }

    match /senderWallets/{walletId} {
      allow read: if (isFinanceAdmin()) || ownsSenderRecord(walletId);
      allow create, update, delete: if false;
    }

    match /referrals/{referredUid} {
      allow read: if (isSupportAdmin() || isRiskAdmin()) || (signedIn() && (
        referredUid == request.auth.uid ||
        resource.data.referrerUserId == request.auth.uid
      ));
      allow create, update, delete: if false;
    }

    match /wallets/{walletId} {
      allow read: if (isFinanceAdmin()) || (signedIn() && (
        resource.data.uid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        walletId == request.auth.uid
      ));
      allow create, update, delete: if false;
    }

    match /walletTransactions/{transactionId} {
      allow read: if (isFinanceAdmin()) || (signedIn() && (
        resource.data.uid == request.auth.uid ||
        resource.data.userId == request.auth.uid
      ));
      allow create, update, delete: if false;
    }

    match /history/{historyId} {
      allow read: if (isOperationsAdmin() || isSupportAdmin() || isDriverManager()) || isOwnDelivery(historyId) || isAssignedRider();
      allow create, update: if false;
      allow delete: if false;
    }

    match /prescriptionPickups/{pickupId} {
      allow read: if (isOperationsAdmin()) ||
        canReadBusinessId(resource.data.businessId) ||
        (signedIn() && resource.data.senderId == request.auth.uid) ||
        (signedIn() && resource.data.userId == request.auth.uid) ||
        isAssignedRider();
      allow create, update, delete: if false;
    }

    match /healthPlusProfiles/{profileId} {
      allow read: if (isOperationsAdmin()) ||
        (signedIn() && resource.data.senderId == request.auth.uid) ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if false;
      allow delete: if false;
    }

    match /recurringPickupSchedules/{scheduleId} {
      allow read: if (isOperationsAdmin()) ||
        (signedIn() && resource.data.senderId == request.auth.uid) ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if false;
      allow delete: if false;
    }

    match /healthPlusNotifications/{notificationId} {
      allow read: if (isOperationsAdmin()) ||
        (signedIn() && resource.data.senderId == request.auth.uid) ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if false;
      allow update, delete: if false;
    }

    match /healthPlusUsageEvents/{eventId} {
      allow read: if (isOperationsAdmin()) ||
        (signedIn() && resource.data.senderId == request.auth.uid) ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if false;
      allow update, delete: if false;
    }

    match /riderApplications/{applicationId} {
      allow read: if (isDriverManager()) ||
        (signedIn() && applicationId == request.auth.uid) ||
        (signedIn() && resource.data.riderId == request.auth.uid);
      allow create, update: if false;
      allow delete: if false;
    }

    match /riderOnboardingEvents/{eventId} {
      allow read: if (isDriverManager());
      allow create: if false;
      allow update, delete: if false;
    }

    match /riderEarnings/{riderId} {
      allow read: if (isFinanceAdmin()) || (signedIn() && riderId == request.auth.uid);
      allow create, update: if false;
      allow delete: if false;
    }

    match /riderEarningsReconciliations/{reconciliationId} {
      allow read: if isFinanceAdmin();
      allow write: if false;
    }

    match /riderWalletTransactions/{transactionId} {
      allow read: if (isFinanceAdmin()) ||
        (signedIn() && resource.data.riderId == request.auth.uid);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /riderPayoutAllocations/{allocationId} {
      allow read: if (isFinanceAdmin()) || (signedIn() && resource.data.riderId == request.auth.uid);
      allow write: if false;
    }
    match /tipRecoveries/{recoveryId} {
      allow read: if (isFinanceAdmin()) || (signedIn() && resource.data.riderId == request.auth.uid);
      allow write: if false;
    }
    match /payoutRequests/{requestId} {
      allow read: if (isFinanceAdmin()) ||
        (signedIn() && resource.data.riderId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /stripeConnectWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    match /deliveryCancellationSettlements/{deliveryId} {
      allow read, write: if false;
    }

    match /riderBankAccounts/{riderId} {
      allow read: if (isFinanceAdmin());
      allow create, update: if false;
      allow delete: if false;
    }

    match /riderDocuments/{documentId} {
      allow read: if (isDriverManager()) ||
        (signedIn() && resource.data.riderId == request.auth.uid);
      allow create, update: if false;
      allow delete: if false;
    }

    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
