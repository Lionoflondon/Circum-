rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn() && (
        request.auth.token.adminRole == role ||
        request.auth.token.role == role ||
        (request.auth.token.roles is list && role in request.auth.token.roles)
      );
    }

    function isAdmin() {
      return hasRole('super_admin') ||
        hasRole('operations_admin') ||
        hasRole('support_agent') ||
        hasRole('finance_admin') ||
        hasRole('driver_manager') ||
        hasRole('gifts_admin');
    }

    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    function isIrisAdmin() {
      return hasRole('super_admin') || hasRole('operations_admin');
    }

    function isSafeUpload() {
      return request.resource != null &&
        request.resource.size <= 15 * 1024 * 1024 &&
        request.resource.contentType is string &&
        request.resource.contentType.matches('image/.*|application/pdf');
    }

    function isGiftVoiceNoteOwner(requestId) {
      return signedIn() && requestId.matches('^' + request.auth.uid + '_[0-9]+$');
    }

    function isSafeGiftVoiceNoteUpload() {
      return request.resource != null &&
        request.resource.size <= 60 * 1024 * 1024 &&
        request.resource.contentType is string &&
        request.resource.contentType.matches('audio/webm|audio/mpeg|audio/mp4|audio/aac|audio/ogg');
    }

    function delivery(deliveryId) {
      return firestore.get(/databases/(default)/documents/deliveryRequests/$(deliveryId)).data;
    }

    function healthPickup(pickupId) {
      return firestore.get(/databases/(default)/documents/prescriptionPickups/$(pickupId)).data;
    }

    function isAssignedHealthRider(pickupId) {
      return signedIn() &&
        ((firestore.exists(/databases/(default)/documents/deliveryRequests/$('health_' + pickupId)) &&
          (delivery('health_' + pickupId).assignedRiderId == request.auth.uid ||
           delivery('health_' + pickupId).riderId == request.auth.uid ||
           delivery('health_' + pickupId).assignedDriverId == request.auth.uid)) ||
         (firestore.exists(/databases/(default)/documents/prescriptionPickups/$(pickupId)) &&
          healthPickup(pickupId).assignedDriverId == request.auth.uid));
    }

    function isAssignedDeliveryRider(deliveryId) {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/deliveryRequests/$(deliveryId)) &&
        (delivery(deliveryId).riderId == request.auth.uid ||
         delivery(deliveryId).driverId == request.auth.uid ||
         delivery(deliveryId).assignedRiderId == request.auth.uid ||
         delivery(deliveryId).assignedDriverId == request.auth.uid);
    }

    match /delivery-discrepancies/{deliveryId}/{riderId}/{fileName} {
      allow read: if isAdmin() || isAssignedDeliveryRider(deliveryId);
      allow create: if resource == null && request.auth.uid == riderId && isAssignedDeliveryRider(deliveryId) && evidenceDeliveryOpen(deliveryId) &&
        isSafeUpload() &&
        request.resource.metadata.deliveryId == deliveryId &&
        request.resource.metadata.uploadedBy == request.auth.uid &&
        request.resource.metadata.evidenceType == 'weight_discrepancy';
      allow update, delete: if false;
    }

    function evidenceDelivery(deliveryId) {
      return firestore.get(/databases/(default)/documents/deliveryRequests/$(deliveryId)).data;
    }

    function evidenceRider(deliveryId) {
      let d = evidenceDelivery(deliveryId);
      return signedIn() && (d.get('riderId', '') == request.auth.uid ||
        d.get('driverId', '') == request.auth.uid ||
        d.get('assignedRiderId', '') == request.auth.uid ||
        d.get('assignedDriverId', '') == request.auth.uid);
    }

    function evidenceDeliveryOpen(deliveryId) {
      return !(evidenceDelivery(deliveryId).get('status', '') in [
        'delivered', 'completed', 'cancelled', 'canceled', 'expired',
        'settlement_pending', 'cancelled_verified_discrepancy'
      ]);
    }

    match /delivery_weight_evidence/{deliveryId}/{stage}/{fileName} {
      allow read: if isAdmin() || evidenceRider(deliveryId);
      allow create: if resource == null && evidenceRider(deliveryId) && evidenceDeliveryOpen(deliveryId) &&
        stage.matches('pickup|handover|discrepancy') &&
        fileName.matches('[0-9]+\\.jpg') &&
        request.resource.size > 0 && request.resource.size <= 15 * 1024 * 1024 &&
        request.resource.contentType == 'image/jpeg' &&
        request.resource.metadata.deliveryId == deliveryId &&
        request.resource.metadata.uploadedBy == request.auth.uid &&
        request.resource.metadata.evidenceType == 'weight_discrepancy';
      allow update, delete: if false;
    }


    match /health_delivery_evidence/{pickupId}/{evidenceType}/{fileName} {
      allow read: if isAdmin() || isAssignedHealthRider(pickupId);
      allow create: if resource == null && isAssignedHealthRider(pickupId) && isSafeUpload() &&
        evidenceType.matches('pickup|custody|handover|verification|exception') &&
        request.resource.metadata.pickupId == pickupId &&
        request.resource.metadata.uploadedBy == request.auth.uid &&
        request.resource.metadata.evidenceType == evidenceType;
      allow update, delete: if false;
    }

    match /riderDocuments/{riderId}/{allPaths=**} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == riderId);
      allow create, update: if isAdmin() && isSafeUpload();
      allow delete: if isSuperAdmin();
    }

    match /riders/{riderId}/documents/{allPaths=**} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == riderId);
      allow create, update: if isAdmin() && isSafeUpload();
      allow delete: if isSuperAdmin();
    }

    match /vehicleDocuments/{riderId}/{allPaths=**} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == riderId);
      allow create, update: if isAdmin() && isSafeUpload();
      allow delete: if isSuperAdmin();
    }

    match /profilePhotos/{userId}/{allPaths=**} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update: if (isAdmin() || (signedIn() && request.auth.uid == userId)) &&
        request.resource != null &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType is string &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isSuperAdmin() || (signedIn() && request.auth.uid == userId);
    }

    match /users/{userId}/profile/{fileName} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update: if (isAdmin() || (signedIn() && request.auth.uid == userId)) &&
        fileName.matches('avatar\\.jpg|avatar\\.png') &&
        request.resource != null &&
        request.resource.size <= 8 * 1024 * 1024 &&
        request.resource.contentType is string &&
        request.resource.contentType.matches('image/jpeg|image/jpg|image/png');
      allow delete: if isSuperAdmin() || (signedIn() && request.auth.uid == userId);
    }

    match /rider-profiles/{riderId}/{fileName} {
      allow read: if signedIn() || isAdmin();
      allow create, update: if signedIn() &&
        request.auth.uid == riderId &&
        fileName.matches('profile\\.jpg|thumbnail\\.jpg') &&
        request.resource != null &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType is string &&
        request.resource.contentType.matches('image/jpeg|image/jpg|image/png|image/heic');
      allow delete: if isSuperAdmin() || (signedIn() && request.auth.uid == riderId);
    }

    match /businessUploads/{businessId}/{allPaths=**} {
      allow read, create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /giftAssets/{giftId}/{allPaths=**} {
      allow read, create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /giftStories/{giftId}/{allPaths=**} {
      allow read, create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /irisReferenceImages/{itemId}/{fileName} {
      allow read: if isIrisAdmin();
      allow create, update: if isIrisAdmin() &&
        request.resource != null &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType is string &&
        request.resource.contentType.matches('image/jpeg|image/png|image/webp');
      allow delete: if false;
    }

    match /gift_requests/{requestId}/voice/{fileName} {
      allow read: if isAdmin() || isGiftVoiceNoteOwner(requestId);
      allow create, update: if isGiftVoiceNoteOwner(requestId) && isSafeGiftVoiceNoteUpload();
      allow delete: if isSuperAdmin() || isGiftVoiceNoteOwner(requestId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
